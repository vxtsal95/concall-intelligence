# Optional. Without a key, documents are extracted and stored but not AI-summarized.
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b

POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
MAX_PDF_MB=80
NSE_ENABLED=true
BSE_ENABLED=true
# Comma-separated NSE symbols. Leave blank to monitor all announcements and filter transcript-like titles.
WATCH_SYMBOLS=HINDALCO,MPHASIS,IRCON,PENIND,REFEX
